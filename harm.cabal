-- category:
build-type:          Simple
extra-source-files:  CHANGELOG.md, README.md


source-repository head
   type:     git
   location: https://github.com/ars-magica/harm

common deps
  -- documentation:       True
  other-modules:       ArM.Debug.NoTrace
                       , ArM.Debug.Trace
                       , ArM.Debug.Time
                       , ArM.GameRules
  -- other-extensions:
  build-depends:       base >=4.13  && < 5.0
                       , scientific >= 0.3.7
                       , text >= 1.2.4.0
                       , containers >= 0.6
                       , aeson >= 2.2.0.3
                       , aeson-extra >= 0.5.1
                       , aeson-pretty >= 0.8
                       , yaml >= 0.11.11
                       , filepath >= 1.4
                       , bytestring >= 0.10.10
                       , unordered-containers >= 0.2.18
                       , split >= 0.2.3
                       , utf8-string >= 1.0.2
                       , uri-encode >= 1.5
                       , directory >= 1.3
                       , lists >= 0.4
                       , mtl >= 2.3
  hs-source-dirs:      . , ./src
  default-language:    Haskell2010

common harm-deps
  import:    deps
  other-modules:       ArM.Character
                       -- , TestModule
                       , ArM.Story.Calendar
                       , ArM.Story.HarmObject
                       , ArM.Story
                       , ArM.Character.Character
                       , ArM.Character.CharacterSheet
                       , ArM.Character.Winter
                       , ArM.Types.Harm
                       , ArM.Types.Harm.Character
                       , ArM.Types.Harm.Saga
                       , ArM.Trait.Lab
                       , ArM.Types.Harm.Covenant
                       , Data.KeyPair
                       , ArM.Trait.RawBook
                       , ArM.Types.Advancement
                       , ArM.Types.Advancement.ProtoTrait
                       , ArM.Trait
                       , ArM.Trait.Book
                       , ArM.Trait.Possession
                       , ArM.Trait.Trait
                       , ArM.Trait.Aging
                       , ArM.Trait.TraitKey
                       , ArM.Trait.Weapon
                       , ArM.Character.Combat
                       , ArM.DB.CSV
                       , ArM.DB
                       , ArM.Character.CharGen
                       , ArM.Character.Inference
                       , ArM.Character.Validation
                       , ArM.Character.Virtues
                       , ArM.Character.InGame
                       , ArM.Sheet
                       , ArM.Sheet.Library
                       , ArM.Markdown
                       , ArM.Markdown.Frontmatter
                       , ArM.Markdown.Magus
                       , ArM.Markdown.VF
                       , ArM.Markdown.HOutput
                       , ArM.Markdown.HList
                       , ArM.Markdown.Spell
                       , ArM.Markdown.Possession
                       , ArM.Markdown.SeasonDisplay
                       , ArM.Markdown.Saga
                       , ArM.Covenant.CostBP
